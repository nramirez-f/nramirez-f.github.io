---
import { SITE, PROFILES } from '@/site.config';
import { l, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mx-auto max-w-[44rem] px-5 pt-6 pb-12">
  <div class="border-line text-ink-soft flex flex-col gap-2 border-t pt-4 text-sm sm:flex-row sm:justify-between">
    <p>
      © {year} {SITE.name} · {SITE.group.name}, {l(SITE.university, lang)}
    </p>
    <ul class="flex flex-wrap gap-x-3">
      {
        PROFILES.map((p) => (
          <li>
            <a href={p.href} rel="me" class="no-underline hover:underline">
              {p.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
