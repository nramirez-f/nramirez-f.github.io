---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BaseHead from '@/components/BaseHead.astro';
import { UI, type Lang, type PageKey } from '@/i18n';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  page?: PageKey;
  noindex?: boolean;
}

const { title, description, lang, page, noindex } = Astro.props;
---

<!doctype html>
<html lang={UI[lang].htmlLang}>
  <head>
    <BaseHead title={title} description={description} lang={lang} page={page} noindex={noindex} />
  </head>
  <body class="bg-paper text-ink">
    <a
      href="#content"
      class="bg-paper text-signal sr-only px-3 py-2 focus:not-sr-only focus:absolute focus:top-2 focus:left-2"
    >
      {UI[lang].skip}
    </a>
    <Header lang={lang} page={page} />
    <main id="content" class="mx-auto max-w-[54rem] px-5">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
