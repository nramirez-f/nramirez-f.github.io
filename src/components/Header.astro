---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { SITE } from '@/site.config';
import { PAGES, ROUTES, NAV_LABELS, UI, l, type Lang, type PageKey } from '@/i18n';

interface Props {
  lang: Lang;
  page?: PageKey;
}

const { lang, page } = Astro.props;
const other: Lang = lang === 'es' ? 'en' : 'es';
const switchHref = ROUTES[page ?? 'home'][other];
---

<header class="mx-auto max-w-[44rem] px-5 pt-10 pb-6 sm:pt-14">
  <div class="flex items-start justify-between gap-4">
    <div>
      <a href={ROUTES.home[lang]} class="text-ink text-2xl font-bold no-underline sm:text-[1.7rem]">
        {SITE.name}
      </a>
      <p class="text-ink-soft mt-1 text-[0.95rem]">
        {UI[lang].role} · {l(SITE.university, lang)}
      </p>
    </div>
    <div class="flex shrink-0 items-center gap-1 pt-1">
      <a
        href={switchHref}
        hreflang={other}
        lang={other}
        class="text-ink-soft hover:text-signal px-1 text-sm no-underline"
        title={UI[other].switchTo}
      >
        {other.toUpperCase()}
      </a>
      <ThemeToggle label={UI[lang].themeToggle} />
    </div>
  </div>

  <nav aria-label={lang === 'es' ? 'Principal' : 'Main'} class="border-ink mt-5 border-t border-b py-1.5">
    <ul class="flex flex-wrap gap-x-4 gap-y-0.5 text-[0.95rem]">
      {
        PAGES.map((key) => {
          const isActive = key === page;
          return (
            <li>
              <a
                href={ROUTES[key][lang]}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'no-underline hover:underline',
                  isActive ? 'text-ink font-bold' : 'text-signal',
                ]}
              >
                {NAV_LABELS[key][lang]}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
