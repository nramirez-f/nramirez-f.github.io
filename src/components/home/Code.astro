---
import HomeSection from '@/components/ui/HomeSection.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { SITE } from '@/site.config';
import type { Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const es = lang === 'es';

const strings = {
  loading: es ? 'Cargando repositorios…' : 'Loading repositories…',
  empty: es ? 'Todavía no hay repositorios publicados.' : 'No repositories published yet.',
  failed: es ? 'No se pudo consultar' : 'Could not reach',
  updated: es ? 'Actualizado el' : 'Updated',
};
---

<HomeSection
  section="code"
  lang={lang}
  lead={es
    ? 'Software científico que desarrollo en abierto. La lista se obtiene automáticamente de mis cuentas, ordenada por actividad más reciente.'
    : 'Scientific software I develop in the open. The list is fetched automatically from my accounts, most recently active first.'}
>
  <div class="flex flex-wrap gap-3">
    <Button href={`https://github.com/${SITE.github}`} variant="ghost" rel="me"><Icon name="github" />GitHub</Button>
    <Button href={`https://gitlab.com/${SITE.gitlab}`} variant="ghost" rel="me"><Icon name="gitlab" />GitLab</Button>
  </div>

  <div
    id="repos"
    class="mt-8"
    data-github={SITE.github}
    data-gitlab={SITE.gitlab}
    data-topic={SITE.codeTopic}
    data-lang={lang}
    data-strings={JSON.stringify(strings)}
  >
    <p class="text-ink-soft" data-status>{strings.loading}</p>
    <ul class="grid grid-cols-1 gap-4 md:grid-cols-2" data-list></ul>
  </div>
  <noscript>
    <p class="text-ink-soft">
      {es ? 'Activa JavaScript para ver la lista, o visita mis perfiles.' : 'Enable JavaScript to see the list, or visit my profiles.'}
    </p>
  </noscript>
</HomeSection>

<script>
  // Repositories are fetched in the browser from the public GitHub and
  // GitLab APIs, filtered by topic and merged by last activity. Responses
  // are cached in sessionStorage to stay well below GitHub's 60 req/h limit
  // for anonymous clients.
  interface Repo {
    name: string;
    description: string;
    url: string;
    host: 'GitHub' | 'GitLab';
    language: string | null;
    updatedAt: string;
  }

  const CACHE_MINUTES = 30;
  const root = document.getElementById('repos')!;
  const { github, gitlab, topic, lang } = root.dataset;
  const t = JSON.parse(root.dataset.strings!);
  const status = root.querySelector<HTMLElement>('[data-status]')!;
  const list = root.querySelector<HTMLUListElement>('[data-list]')!;

  async function cached<T>(key: string, load: () => Promise<T>): Promise<T> {
    try {
      const hit = JSON.parse(sessionStorage.getItem(key) ?? 'null');
      if (hit && Date.now() - hit.at < CACHE_MINUTES * 60_000) return hit.data;
    } catch {}
    const data = await load();
    try {
      sessionStorage.setItem(key, JSON.stringify({ at: Date.now(), data }));
    } catch {}
    return data;
  }

  async function getJson(url: string) {
    const res = await fetch(url);
    if (!res.ok) throw new Error(`${res.status} ${url}`);
    return res.json();
  }

  async function fromGitHub(): Promise<Repo[]> {
    const repos = await getJson(`https://api.github.com/users/${github}/repos?per_page=100&sort=pushed`);
    return repos
      .filter((r: any) => !r.fork && !r.archived && r.topics?.includes(topic))
      .map((r: any) => ({
        name: r.name,
        description: r.description ?? '',
        url: r.html_url,
        host: 'GitHub',
        language: r.language,
        updatedAt: r.pushed_at,
      }));
  }

  async function fromGitLab(): Promise<Repo[]> {
    const repos = await getJson(
      `https://gitlab.com/api/v4/users/${gitlab}/projects?per_page=100&order_by=last_activity_at&archived=false`,
    );
    return repos
      .filter((r: any) => (r.topics ?? r.tag_list ?? []).includes(topic))
      .map((r: any) => ({
        name: r.name,
        description: r.description ?? '',
        url: r.web_url,
        host: 'GitLab',
        language: null,
        updatedAt: r.last_activity_at,
      }));
  }

  function render(repos: Repo[], failed: string[]) {
    const fmt = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-GB', { dateStyle: 'medium' });
    list.replaceChildren(
      ...repos.map((r) => {
        const li = document.createElement('li');
        li.className = 'bg-surface border-line flex flex-col rounded-xl border p-4 sm:p-5';
        const head = document.createElement('div');
        head.className = 'flex flex-wrap items-center justify-between gap-2';
        const link = document.createElement('a');
        link.href = r.url;
        link.className = 'font-display text-lg font-bold';
        link.textContent = r.name;
        const tag = document.createElement('span');
        tag.className = 'border-line-strong text-ink-soft rounded-full border px-2 py-px text-xs font-semibold';
        tag.textContent = [r.host, r.language].filter(Boolean).join(' · ');
        head.append(link, tag);
        li.append(head);
        if (r.description) {
          const desc = document.createElement('p');
          desc.className = 'text-ink-soft mt-2 text-sm';
          desc.textContent = r.description;
          li.append(desc);
        }
        const when = document.createElement('p');
        when.className = 'text-ink-soft mt-auto pt-3 text-xs tabular-nums';
        when.textContent = `${t.updated} ${fmt.format(new Date(r.updatedAt))}`;
        li.append(when);
        return li;
      }),
    );
    const notes = failed.map((host) => `${t.failed} ${host}.`);
    if (repos.length === 0 && failed.length === 0) notes.push(t.empty);
    status.textContent = notes.join(' ');
    status.hidden = notes.length === 0;
  }

  const sources = [
    { host: 'GitHub', load: () => cached(`repos:gh:${github}:${topic}`, fromGitHub) },
    { host: 'GitLab', load: () => cached(`repos:gl:${gitlab}:${topic}`, fromGitLab) },
  ];
  const results = await Promise.allSettled(sources.map((s) => s.load()));
  const repos = results
    .flatMap((r) => (r.status === 'fulfilled' ? r.value : []))
    .sort((a, b) => b.updatedAt.localeCompare(a.updatedAt));
  const failed = sources.filter((_, i) => results[i].status === 'rejected').map((s) => s.host);
  render(repos, failed);
</script>
