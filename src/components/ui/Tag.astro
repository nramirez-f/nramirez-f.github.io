---
interface Props {
  tone?: 'plain' | 'accent';
}
const { tone = 'plain' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-full px-2 py-px text-xs font-semibold whitespace-nowrap',
    tone === 'accent' ? 'bg-deep-soft text-deep' : 'border-line-strong text-ink-soft border',
  ]}
>
  <slot />
</span>
