---
// The hero's one memorable thing: a channel cross-section. Two free-surface
// layers drift at different speeds over a still bed of sand. Pure SVG + CSS;
// the drift stops under prefers-reduced-motion.
const W = 1200;
const H = 220;
/** Periodic over the tile width (integer frequencies), so two tiles side by side loop seamlessly. */
const wave = (base: number, terms: [amp: number, freq: number, phase: number][]) => {
  const pts = Array.from({ length: 241 }, (_, i) => {
    const x = (i / 240) * W;
    const y = base + terms.reduce((s, [a, f, p]) => s + a * Math.sin((2 * Math.PI * f * x) / W + p), 0);
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  });
  return { line: `M${pts.join(' L')}`, area: `M${pts.join(' L')} L${W},${H} L0,${H} Z` };
};
const back = wave(70, [[14, 2, 0.6], [6, 5, 2.1]]);
const front = wave(84, [[11, 3, 0], [5, 7, 1.3]]);

const BW = 1200;
const BH = 110;
const bedPts = Array.from({ length: 121 }, (_, i) => {
  const x = (i / 120) * BW;
  const y = 62 - 30 * (x / BW) + 14 * Math.sin((2 * Math.PI * 1.3 * x) / BW + 0.4) + 6 * Math.sin((2 * Math.PI * 4.1 * x) / BW);
  return `${x.toFixed(1)},${y.toFixed(1)}`;
});
const bedLine = `M${bedPts.join(' L')}`;
const bedArea = `${bedLine} L${BW},${BH} L0,${BH} Z`;

const tiles = [0, 1];
---

<div class="pointer-events-none absolute inset-x-0 bottom-0 h-60 sm:h-72" aria-hidden="true">
  {/* Back layer: slower, paler. */}
  <div class="absolute inset-0 overflow-hidden">
    <div class="motion-safe:animate-drift-slow flex h-full w-[200%]">
      {
        tiles.map(() => (
          <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" class="h-full w-1/2 shrink-0">
            <path d={back.area} class="fill-water" fill-opacity="0.1" />
          </svg>
        ))
      }
    </div>
  </div>
  {/* Front layer, with the free-surface line. */}
  <div class="absolute inset-0 overflow-hidden">
    <div class="motion-safe:animate-drift flex h-full w-[200%]">
      {
        tiles.map(() => (
          <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" class="h-full w-1/2 shrink-0">
            <path d={front.area} class="fill-water" fill-opacity="0.16" />
            <path d={front.line} class="stroke-water" fill="none" stroke-width="2" vector-effect="non-scaling-stroke" />
          </svg>
        ))
      }
    </div>
  </div>
  {/* Sand bed. */}
  <svg viewBox={`0 0 ${BW} ${BH}`} preserveAspectRatio="none" class="absolute inset-x-0 bottom-0 h-24 w-full sm:h-28">
    <path d={bedArea} class="fill-sand" />
    <path d={bedLine} class="stroke-bed" fill="none" stroke-width="2" vector-effect="non-scaling-stroke" />
  </svg>
</div>
