---
// One row of a dense chronological list: date column + content.
interface Props {
  when?: string;
}
const { when } = Astro.props;
---

<li class="grid grid-cols-1 gap-x-5 gap-y-0.5 sm:grid-cols-(--cols-entry)">
  <span class="text-ink-soft text-sm font-semibold tabular-nums sm:pt-0.5">{when}</span>
  <div><slot /></div>
</li>
