---
import { getTeachingByYear } from '@/lib/data';
import { l, UI, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const years = await getTeachingByYear();
const ui = UI[lang];
const h =
  lang === 'es'
    ? { subject: 'Asignatura', degree: 'Titulación', kind: 'Tipo', hours: 'Horas', theory: 'Teoría', practice: 'Prácticas', year: 'Curso' }
    : { subject: 'Subject', degree: 'Degree', kind: 'Type', hours: 'Hours', theory: 'Lectures', practice: 'Problem classes', year: 'Academic year' };
---

<div class="space-y-8">
  {
    years.map(({ year, items, hours }) => (
      <div>
        <h3 class="mb-3 text-lg font-bold">
          {h.year} {year}
        </h3>
        {/* Mobile: one stacked row per subject. From sm: the table. */}
        <ul class="border-line bg-surface divide-line divide-y rounded-xl border text-sm sm:hidden">
          {items.map((r) => (
            <li class="px-4 py-3">
              <span class="flex items-baseline justify-between gap-3">
                <span class="font-bold">{l(r.data.subject, lang)}</span>
                <span class="shrink-0 tabular-nums">
                  {r.data.hours} {ui.hours}
                </span>
              </span>
              <span class="text-ink-soft block">
                {l(r.data.degree, lang)} · {r.data.kind === 'theory' ? h.theory : h.practice}
              </span>
            </li>
          ))}
          <li class="flex justify-between px-4 py-3 font-bold">
            <span>{ui.total}</span>
            <span class="tabular-nums">
              {hours} {ui.hours}
            </span>
          </li>
        </ul>
        <div class="border-line bg-surface hidden overflow-x-auto rounded-xl border sm:block">
          <table class="w-full border-collapse text-sm">
            <thead class="bg-surface-2 text-ink-soft text-left">
              <tr>
                <th class="w-2/5 px-4 py-2.5 font-semibold">{h.subject}</th>
                <th class="px-4 py-2.5 font-semibold">{h.degree}</th>
                <th class="px-4 py-2.5 font-semibold">{h.kind}</th>
                <th class="px-4 py-2.5 text-right font-semibold">{h.hours}</th>
              </tr>
            </thead>
            <tbody>
              {items.map((r) => (
                <tr class="border-line border-t">
                  <td class="px-4 py-2.5 font-semibold">{l(r.data.subject, lang)}</td>
                  <td class="text-ink-soft px-4 py-2.5">{l(r.data.degree, lang)}</td>
                  <td class="text-ink-soft px-4 py-2.5">{r.data.kind === 'theory' ? h.theory : h.practice}</td>
                  <td class="px-4 py-2.5 text-right tabular-nums">{r.data.hours}</td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr class="border-line-strong border-t font-bold">
                <td class="px-4 py-2.5" colspan="3">
                  {ui.total}
                </td>
                <td class="px-4 py-2.5 text-right tabular-nums">
                  {hours} {ui.hours}
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    ))
  }
</div>
