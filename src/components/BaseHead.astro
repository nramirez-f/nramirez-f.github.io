---
import { Font } from 'astro:assets';
import { SITE } from '@/site.config';
import { ROUTES, UI, LANGS, l, type Lang, type PageKey } from '@/i18n';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  page?: PageKey;
  noindex?: boolean;
}

const { title: pageTitle, description: pageDescription, lang, page, noindex = false } = Astro.props;

const fullTitle = pageTitle === SITE.name ? SITE.name : `${pageTitle} · ${SITE.name}`;
const description = pageDescription || UI[lang].description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const ogImageAlt =
  lang === 'es'
    ? `${SITE.name} · Doctorando en Matemática Aplicada · EDANYA, Universidad de Málaga`
    : `${SITE.name} · PhD student in Applied Mathematics · EDANYA, University of Málaga`;

// Structured data (schema.org) on the home page: tells search engines who the
// site is about, the name variants people search for, and the linked profiles.
const profiles = [
  SITE.orcid && `https://orcid.org/${SITE.orcid}`,
  `https://github.com/${SITE.github}`,
  `https://gitlab.com/${SITE.gitlab}`,
  SITE.scholar && `https://scholar.google.com/citations?user=${SITE.scholar}`,
].filter(Boolean);
const uma = { '@type': 'CollegeOrUniversity', name: 'Universidad de Málaga', url: 'https://www.uma.es/' };
const jsonLd =
  page === 'home'
    ? {
        '@context': 'https://schema.org',
        '@type': 'ProfilePage',
        url: canonicalURL.href,
        inLanguage: UI[lang].htmlLang,
        mainEntity: {
          '@type': 'Person',
          '@id': new URL('/#person', Astro.site).href,
          name: SITE.name,
          givenName: 'José Ignacio',
          familyName: 'Ramírez-Fuentes',
          alternateName: ['José Ignacio Ramírez Fuentes', 'Jose Ignacio Ramirez Fuentes', 'J. I. Ramírez-Fuentes'],
          url: new URL('/', Astro.site).href,
          email: `mailto:${SITE.email}`,
          jobTitle: UI[lang].role,
          description: pageDescription,
          affiliation: [
            {
              '@type': 'ResearchOrganization',
              name: `${SITE.group.name} – ${l(SITE.group.fullName, lang)}`,
              url: SITE.group.url,
              parentOrganization: uma,
            },
            uma,
          ],
          alumniOf: uma,
          ...(SITE.orcid && {
            identifier: { '@type': 'PropertyValue', propertyID: 'ORCID', value: SITE.orcid },
          }),
          sameAs: profiles,
          knowsAbout: [
            'Hyperbolic systems of balance laws',
            'Finite volume methods',
            'Well-balanced schemes',
            'Semi-implicit schemes',
            'Shallow-water equations',
            'Numerical analysis',
            'Computational fluid dynamics',
          ],
        },
      }
    : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="author" content={SITE.name} />

<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex" />}
{
  page &&
    LANGS.map((alt) => (
      <link rel="alternate" hreflang={alt} href={new URL(ROUTES[page][alt], Astro.site)} />
    ))
}
{page && <link rel="alternate" hreflang="x-default" href={new URL(ROUTES[page].es, Astro.site)} />}

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={page === 'home' ? 'profile' : 'website'} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={UI[lang].dateLocale.replace('-', '_')} />
<meta property="og:locale:alternate" content={lang === 'es' ? 'en_GB' : 'es_ES'} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
{page === 'home' && <meta property="profile:first_name" content="José Ignacio" />}
{page === 'home' && <meta property="profile:last_name" content="Ramírez-Fuentes" />}
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />

<Font cssVariable="--ff-serif" preload />
<Font cssVariable="--ff-mono" />

<script is:inline>
  // Runs before first paint to avoid a flash of the wrong theme.
  (function () {
    let stored = null;
    try {
      stored = localStorage.getItem('theme');
    } catch {}
    const theme =
      stored ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.classList.toggle('dark', theme === 'dark');
  })();
</script>
