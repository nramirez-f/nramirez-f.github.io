---
// The home page: hero, figures and news, then every section in the order of
// SECTIONS (src/i18n.ts), each at its own anchor.
import Container from '@/components/ui/Container.astro';
import Hero from '@/components/home/Hero.astro';
import Metrics from '@/components/home/Metrics.astro';
import News from '@/components/home/News.astro';
import Research from '@/components/home/Research.astro';
import Publications from '@/components/home/Publications.astro';
import Talks from '@/components/home/Talks.astro';
import Projects from '@/components/home/Projects.astro';
import Teaching from '@/components/home/Teaching.astro';
import Outreach from '@/components/home/Outreach.astro';
import Code from '@/components/home/Code.astro';
import Contact from '@/components/home/Contact.astro';
import type { Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Hero lang={lang} />
<Container class="relative z-10 -mt-14">
  <Metrics lang={lang} />
</Container>
<News lang={lang} />
<Research lang={lang} />
<Publications lang={lang} />
<Talks lang={lang} />
<Projects lang={lang} />
<Teaching lang={lang} />
<Outreach lang={lang} />
<Code lang={lang} />
<Contact lang={lang} />
