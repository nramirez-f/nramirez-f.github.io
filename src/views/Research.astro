---
import Section from '@/components/Section.astro';
import Entry from '@/components/Entry.astro';
import Tex from '@/components/Tex.astro';
import ShallowWaterFigure from '@/components/ShallowWaterFigure.astro';
import ProjectItem from '@/components/ProjectItem.astro';
import PublicationItem from '@/components/PublicationItem.astro';
import { SITE } from '@/site.config';
import { getProjects, getPublications } from '@/lib/data';
import { l, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const TFM_URL = 'https://github.com/nramirez-f/Lid-Driven-Cavity';
const es = lang === 'es';

const [projects, pubs] = await Promise.all([getProjects(), getPublications()]);
const papers = pubs.filter((p) => p.data.status === 'published' || p.data.status === 'accepted');
const preprints = pubs.filter((p) => p.data.status === 'submitted' || p.data.status === 'preprint');

const shallowWater = String.raw`
\begin{aligned}
  \partial_t h + \nabla\cdot(h\mathbf{u}) &= 0,\\
  \partial_t (h\mathbf{u}) + \nabla\cdot\left(h\,\mathbf{u}\otimes\mathbf{u}\right)
    + \nabla\!\left(\tfrac{g}{2}h^2\right) &= g\,h\,\nabla H .
\end{aligned}`;
---

<p>
  {
    es
      ? 'Mi investigación se centra en métodos de volúmenes finitos bien equilibrados para sistemas hiperbólicos bidimensionales de leyes de balance, y en particular para el sistema de aguas someras (Shallow-Water):'
      : 'My research focuses on well-balanced finite volume methods for two-dimensional hyperbolic systems of balance laws, in particular the shallow-water system:'
  }
</p>
<div class="my-3"><Tex tex={shallowWater} display /></div>
<p>
  {
    es ? (
      <>
        donde <Tex tex="h" /> es el espesor de la lámina de agua, <Tex tex="\mathbf{u}" /> la velocidad
        promediada en vertical, <Tex tex="g" /> la aceleración de la gravedad y <Tex tex="H" /> la
        profundidad del fondo medida desde un nivel de referencia fijo, de modo que la superficie libre es{' '}
        <Tex tex="\eta = h - H" />. Un esquema bien equilibrado preserva estados estacionarios
        como el lago en reposo:
      </>
    ) : (
      <>
        where <Tex tex="h" /> is the water depth, <Tex tex="\mathbf{u}" /> the depth-averaged velocity,{' '}
        <Tex tex="g" /> the gravitational acceleration and <Tex tex="H" /> the depth of the bottom measured
        from a fixed reference level, so that the free surface is <Tex tex="\eta = h - H" />. A
        well-balanced scheme preserves steady states such as the lake at rest:
      </>
    )
  }
</p>
<div class="my-3">
  <Tex tex={String.raw`\eta = h - H = \text{${es ? 'cte' : 'const'}}, \qquad \mathbf{u} = \mathbf{0}.`} display />
</div>
<p>
  {
    es
      ? 'Actualmente desarrollo un esquema semi-implícito para este sistema en dos dimensiones.'
      : 'I am currently developing a semi-implicit scheme for this system in two dimensions.'
  }
</p>

<ShallowWaterFigure lang={lang} />

<Section title={es ? 'Publicaciones' : 'Publications'} id="publications">
  {
    papers.length > 0 && (
      <>
        <h3 class="mb-2 text-lg">{es ? 'Artículos' : 'Journal articles'}</h3>
        <ul class="entries mb-6">
          {papers.map((p) => (
            <PublicationItem pub={p} lang={lang} />
          ))}
        </ul>
      </>
    )
  }
  {
    preprints.length > 0 && (
      <>
        <h3 class="mb-2 text-lg">{es ? 'Preprints y artículos enviados' : 'Preprints and submitted papers'}</h3>
        <ul class="entries mb-6">
          {preprints.map((p) => (
            <PublicationItem pub={p} lang={lang} />
          ))}
        </ul>
      </>
    )
  }
  {
    pubs.length === 0 && (
      <p class="text-ink-soft mb-6">
        {es
          ? 'Primer artículo en revisión; aparecerá aquí en cuanto esté disponible como preprint.'
          : 'First paper under review; it will appear here as soon as the preprint is available.'}
      </p>
    )
  }
  <h3 class="mb-2 text-lg">{es ? 'Trabajos académicos' : 'Theses'}</h3>
  <ul class="entries">
    <Entry when="2024">
      <span class="font-bold">
        {es ? 'Las ecuaciones de Navier–Stokes. Teoría e implementación numérica' : 'Navier–Stokes equations. Theory and numerical implementation'}
      </span>
      <span class="text-ink-soft block">
        {es ? 'Trabajo Fin de Máster, Máster en Matemáticas, Universidad de Málaga. Matrícula de Honor.' : 'Master thesis, MSc in Mathematics, University of Málaga. With Honours.'}
      </span>
      <a href={TFM_URL} class="text-[0.95rem]">[{es ? 'Memoria y código (Lid-Driven Cavity)' : 'Thesis and code (Lid-Driven Cavity)'}]</a>
    </Entry>
    <Entry when="2022">
      <span class="font-bold">
        {es ? 'Transformada Z y sus aplicaciones a señales y sistemas' : 'Z-transform and applications to signals and systems'}
      </span>
      <span class="text-ink-soft block">
        {es ? 'Trabajo Fin de Grado, Grado en Matemáticas, Universidad de Málaga.' : 'Bachelor thesis, BSc in Mathematics, University of Málaga.'}
      </span>
    </Entry>
  </ul>
</Section>

<Section title={es ? 'Proyectos de investigación' : 'Research projects'} id="projects">
  <ul class="entries">
    {projects.map((p) => <ProjectItem project={p} lang={lang} />)}
  </ul>
</Section>

<Section title={es ? 'Grupo de investigación y doctorado' : 'Research group and PhD'} id="group">
  <p>
    {es ? 'Miembro del grupo' : 'Member of the research group'} <a href={SITE.group.url}>{SITE.group.name}</a> ({SITE.group.code}) —{' '}
    {l(SITE.group.fullName, lang)}, {l(SITE.university, lang)}, {es ? 'desde 2025.' : 'since 2025.'}
  </p>
  <p class="mt-2">
    {es ? 'Doctorando del' : 'PhD student in the'} <a href={SITE.phd.url}>{l(SITE.phd.program, lang)}</a>{' '}
    {es ? `desde ${SITE.phd.start}.` : `since ${SITE.phd.start}.`}{' '}
    {es ? 'Directores de tesis' : 'Advisors'}:{' '}
    {
      SITE.advisors.map((a, i) => (
        <>
          {i > 0 && (es ? ' y ' : ' and ')}
          <a href={a.url}>{a.name}</a>
        </>
      ))
    }. Tutor: <a href={SITE.tutor.url}>{SITE.tutor.name}</a>.
  </p>
</Section>
