---
// Section of the CV page (the home page uses ui/HomeSection).
interface Props {
  title: string;
  id?: string;
}
const { title, id } = Astro.props;
---

<section id={id} class="mt-12 first:mt-6">
  <h2 class="border-line mb-5 border-b pb-2 text-2xl font-bold">{title}</h2>
  <slot />
</section>
