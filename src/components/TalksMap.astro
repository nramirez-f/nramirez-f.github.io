---
// Map of the talks as a full-width band blended into the page: countries
// shaded by number of talks, an arc from Málaga to every city, and a summary
// laid over the Atlantic. Outlines are pre-generated by
// scripts/europe-map.py; markers use the same equirectangular projection.
// The marks are drawn in order of date as the band scrolls into view (map-*
// utilities in global.css). A small script adds the only interactivity:
// hovering, tapping or focusing a visited country shows its talks.
import type { CollectionEntry } from 'astro:content';
import { EUROPE } from '@/data/europe-outline';
import { l, formatRange, type Lang } from '@/i18n';

interface Props {
  talks: CollectionEntry<'talks'>[];
  lang: Lang;
}
const { talks, lang } = Astro.props;
const es = lang === 'es';

const project = ([lat, lon]: readonly [number, number]) => ({
  x: (lon - EUROPE.lonMin) * EUROPE.cos * EUROPE.k,
  y: (EUROPE.latMax - lat) * EUROPE.k,
});
const home = { name: 'Málaga', ...project([36.72, -4.42]) };

// Oldest first, so the reveal follows the order of the trips.
const chronological = [...talks].sort((a, b) => a.data.start.valueOf() - b.data.start.valueOf());

// One marker per city, however many talks were given there.
const cities = new Map<string, { name: string; country: string; cc: string; x: number; y: number; count: number }>();
for (const talk of chronological) {
  const name = l(talk.data.city, lang);
  const prev = cities.get(name);
  cities.set(name, {
    name,
    country: l(talk.data.country, lang),
    cc: talk.data.countryCode,
    ...project(talk.data.coords),
    count: (prev?.count ?? 0) + 1,
  });
}
const markers = [...cities.values()].map((m, i, all) => {
  // Put the label on the left when another marker sits just to the right.
  const crowded = all.some((o) => o !== m && o.x > m.x && o.x - m.x < 150 && Math.abs(o.y - m.y) < 32);
  // Quadratic arc from Málaga, bowed to the left of the direction of travel.
  const dx = m.x - home.x;
  const dy = m.y - home.y;
  const cx = (home.x + m.x) / 2 + dy * 0.25;
  const cy = (home.y + m.y) / 2 - Math.abs(dx) * 0.25;
  return {
    ...m,
    side: crowded ? 'left' : 'right',
    arc: `M${home.x.toFixed(1)},${home.y.toFixed(1)} Q${cx.toFixed(1)},${cy.toFixed(1)} ${m.x.toFixed(1)},${m.y.toFixed(1)}`,
    // Stagger: seconds after load (fallback) and % of the scroll range.
    style: `--d: ${(0.5 + i * 0.35).toFixed(2)}; --r0: ${10 + i * 7}`,
  };
});

// Talks per country → one of four shades of the water colour.
const byCountry = new Map<string, typeof chronological>();
for (const talk of chronological) byCountry.set(talk.data.countryCode, [...(byCountry.get(talk.data.countryCode) ?? []), talk]);
const shade = (n: number) => (n >= 10 ? 0.85 : n >= 4 ? 0.65 : n >= 2 ? 0.45 : 0.3);
const talksLabel = (n: number) => (es ? `${n} ${n === 1 ? 'comunicación' : 'comunicaciones'}` : `${n} ${n === 1 ? 'talk' : 'talks'}`);
const visited = EUROPE.countries
  .filter((c) => byCountry.has(c.code))
  .map((c, i) => {
    const items = byCountry.get(c.code)!;
    return {
      ...c,
      name: l(items[0].data.country, lang),
      items,
      opacity: shade(items.length),
      style: `--d: ${(0.2 + i * 0.2).toFixed(2)}; --r0: ${i * 5}`,
    };
  });

const firstYear = chronological[0]?.data.start.getUTCFullYear();
const summary = es
  ? `${talks.length} comunicaciones en ${byCountry.size} países desde ${firstYear}.`
  : `${talks.length} talks in ${byCountry.size} countries since ${firstYear}.`;
const hint = es ? 'Pasa el cursor o pulsa sobre un país para ver sus comunicaciones.' : 'Hover over or tap a country to see its talks.';
const caption = es
  ? 'Mapa de Europa con un arco desde Málaga hasta cada ciudad donde he presentado una comunicación; los países se colorean según el número de comunicaciones.'
  : 'Map of Europe with an arc from Málaga to every city where I have given a talk; countries are shaded by number of talks.';
---

<figure data-talks-map class="map-timeline relative">
  <figcaption class="sr-only">{caption}</figcaption>
  <div class="relative h-80 overflow-hidden sm:h-104 xl:h-120">
    <svg
      viewBox={`0 0 ${EUROPE.width} ${EUROPE.height}`}
      preserveAspectRatio="xMidYMax slice"
      class="mask-x-from-95% mask-y-from-90% sm:mask-x-from-85% absolute inset-0 h-full w-full"
      role="group"
      aria-label={`${caption} ${markers.map((m) => `${m.name} (${m.count})`).join(', ')}.`}
    >
      <g class="fill-line stroke-paper" stroke-width="1" stroke-linejoin="round" aria-hidden="true">
        {EUROPE.countries.map((c) => <path d={c.d} />)}
      </g>
      <g class="fill-water stroke-paper" stroke-width="1" stroke-linejoin="round">
        {
          visited.map((c) => (
            <path
              d={c.d}
              fill-opacity={c.opacity}
              data-country={c.code}
              tabindex="0"
              role="button"
              aria-label={`${c.name}: ${talksLabel(c.items.length)}`}
              class="motion-safe:map-fill data-hot:fill-deep focus-visible:stroke-ink cursor-pointer transition-colors outline-none"
              style={c.style}
            />
          ))
        }
      </g>

      <g class="stroke-deep pointer-events-none" fill="none" stroke-width="2" stroke-linecap="round" stroke-opacity="0.6" aria-hidden="true">
        {markers.map((m) => <path d={m.arc} pathLength="1" class="motion-safe:map-draw" style={m.style} />)}
      </g>

      <g class="fill-ink pointer-events-none" aria-hidden="true">
        <circle cx={home.x} cy={home.y} r="4.5" class="motion-safe:map-ring stroke-ink" fill="none" stroke-width="1" />
        <circle cx={home.x} cy={home.y} r="4.5" class="stroke-paper" stroke-width="1.5" />
        <text x={home.x + 10} y={home.y + 22} font-size="24" class="stroke-paper font-serif italic" stroke-width="5" paint-order="stroke">
          {home.name}
        </text>
      </g>

      {
        markers.map((m) => (
          <g class="pointer-events-none" aria-hidden="true">
            <circle
              cx={m.x}
              cy={m.y}
              r="5"
              data-city={m.name}
              class="fill-deep stroke-paper motion-safe:map-pop transform-fill origin-center transition-[scale] data-hot:scale-150"
              stroke-width="1.5"
              style={m.style}
            />
            <text
              x={m.side === 'left' ? m.x - 11 : m.x + 11}
              y={m.y + 7}
              text-anchor={m.side === 'left' ? 'end' : 'start'}
              font-size="22"
              font-weight="700"
              class="fill-ink stroke-paper font-sans"
              stroke-width="5"
              paint-order="stroke"
            >
              {m.name}
              {m.count > 1 && ` (${m.count})`}
            </text>
          </g>
        ))
      }
    </svg>

    {/* Talks of the hovered or focused country, filled from the templates below. */}
    <div
      data-tip
      role="status"
      hidden
      class="border-line bg-surface shadow-card pointer-events-none absolute z-10 w-72 rounded-xl border p-4 text-sm"
    >
    </div>
  </div>

  {/*
    Summary: below the band, or laid over the Atlantic on wide screens. There
    it is placed in % of the band, like the map (scaled to the band width),
    so it never reaches the coast of Portugal at ≈ 30 % from the left.
  */}
  <div class="max-w-site mx-auto px-4 sm:px-6 xl:absolute xl:top-1/2 xl:left-1/30 xl:w-1/4 xl:max-w-none xl:-translate-y-1/2 xl:px-0">
    <div class="mt-6 max-w-xs xl:mt-0">
      <p class="font-display text-2xl leading-snug font-bold">{summary}</p>
      <ul class="mt-4 grid gap-2">
        {
          markers.map((m) => (
            <li data-city-item={m.name} data-cc={m.cc} class="data-hot:text-deep flex items-baseline justify-between gap-3 transition-colors">
              <span>
                <span class="font-bold">{m.name}</span> <span class="text-ink-soft">{m.country}</span>
              </span>
              <span class="text-ink-soft tabular-nums">{m.count}</span>
            </li>
          ))
        }
      </ul>
      <p class="text-ink-soft mt-4 text-sm">{hint}</p>
    </div>
  </div>

  {
    visited.map((c) => (
      <template data-country-talks={c.code}>
        <p class="font-display text-lg leading-tight font-bold">{c.name}</p>
        <p class="text-ink-soft text-xs">{talksLabel(c.items.length)}</p>
        <ul class="mt-3 grid gap-3">
          {c.items.map((t) => (
            <li>
              <span class="block leading-snug font-bold">{t.data.title}</span>
              <span class="text-ink-soft block text-xs">
                {l(t.data.city, lang)}, {formatRange(t.data.start, t.data.end, lang)}
              </span>
            </li>
          ))}
        </ul>
      </template>
    ))
  }
</figure>

<script>
  // Country ↔ talks panel ↔ city list. Mouse: hover. Touch: tap (tap the
  // country again or elsewhere to close). Keyboard: focus, Esc to close.
  const root = document.querySelector<HTMLElement>('[data-talks-map]');
  const tip = root?.querySelector<HTMLElement>('[data-tip]');
  if (root && tip) {
    const band = tip.parentElement!;
    const countries = [...root.querySelectorAll<SVGPathElement>('[data-country]')];
    const items = [...root.querySelectorAll<HTMLElement>('[data-city-item]')];
    let active: string | null = null;
    // A tap focuses the country before its click: let the click decide.
    let pressing = false;

    const mark = (cc: string | null) => {
      countries.forEach((c) => c.toggleAttribute('data-hot', c.dataset.country === cc));
      items.forEach((it) => {
        const hot = it.dataset.cc === cc;
        it.toggleAttribute('data-hot', hot);
        root.querySelector(`[data-city="${it.dataset.cityItem}"]`)?.toggleAttribute('data-hot', hot);
      });
    };

    const place = (x: number, y: number) => {
      const box = band.getBoundingClientRect();
      const left = Math.min(Math.max(x - box.left + 16, 16), box.width - tip.offsetWidth - 16);
      const top = Math.min(Math.max(y - box.top + 16, 16), box.height - tip.offsetHeight - 16);
      tip.style.left = `${left}px`;
      tip.style.top = `${top}px`;
    };

    const show = (cc: string, x: number, y: number) => {
      if (active !== cc) {
        const template = root.querySelector<HTMLTemplateElement>(`[data-country-talks="${cc}"]`);
        if (!template) return;
        tip.replaceChildren(template.content.cloneNode(true));
        active = cc;
      }
      tip.hidden = false;
      mark(cc);
      place(x, y);
    };

    const hide = () => {
      tip.hidden = true;
      active = null;
      mark(null);
    };

    for (const country of countries) {
      const cc = country.dataset.country!;
      country.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && show(cc, e.clientX, e.clientY));
      country.addEventListener('pointermove', (e) => e.pointerType === 'mouse' && place(e.clientX, e.clientY));
      country.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && hide());
      country.addEventListener('pointerdown', () => (pressing = true));
      country.addEventListener('click', (e) => {
        pressing = false;
        if ((e as PointerEvent).pointerType === 'mouse') return;
        if (active === cc) hide();
        else show(cc, e.clientX, e.clientY);
      });
      country.addEventListener('focus', () => {
        if (pressing || active === cc) return;
        const r = country.getBoundingClientRect();
        show(cc, r.left + r.width / 2, r.top + r.height / 2);
      });
      country.addEventListener('blur', hide);
    }

    // The list highlights its city and country on the map.
    for (const item of items) {
      item.addEventListener('pointerenter', () => mark(item.dataset.cc!));
      item.addEventListener('pointerleave', () => active === null && mark(null));
    }

    document.addEventListener('keydown', (e) => e.key === 'Escape' && hide());
    document.addEventListener('click', (e) => {
      if (active && !(e.target as Element).closest('[data-country]')) hide();
    });
  }
</script>
