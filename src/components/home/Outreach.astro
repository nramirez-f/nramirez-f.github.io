---
import { Image } from 'astro:assets';
import HomeSection from '@/components/ui/HomeSection.astro';
import Card from '@/components/ui/Card.astro';
import { JEMA_URL } from '@/data/cv';
import jemaLogo from '@/assets/images/jema-seminarios.png';
import type { Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const es = lang === 'es';
---

<HomeSection section="outreach" lang={lang}>
  <Card class="grid grid-cols-1 items-center gap-6 md:grid-cols-5 md:gap-10">
    <a href={JEMA_URL} class="block rounded-xl bg-white p-4 md:col-span-2">
      <Image
        src={jemaLogo}
        width={640}
        alt={es ? 'Seminarios JEMA – Jóvenes Españoles de Matemática Aplicada' : 'JEMA Seminars – Jóvenes Españoles de Matemática Aplicada'}
        class="block h-auto w-full"
      />
    </a>
    <div class="md:col-span-3">
      <h3 class="mb-3 text-xl font-bold">{es ? 'Seminarios JEMA' : 'JEMA Seminars'}</h3>
      <p>
        {
          es ? (
            <>
              Desde 2026 soy co-organizador de los <a href={JEMA_URL}>Seminarios JEMA</a> (Jóvenes Españoles de
              Matemática Aplicada) de la Sociedad Española de Matemática Aplicada (SEMA): sesiones mensuales en
              línea en las que jóvenes investigadores presentan su trabajo en matemática aplicada y crean red con
              otros grupos.
            </>
          ) : (
            <>
              Since 2026 I co-organise the <a href={JEMA_URL}>JEMA Seminars</a> (<em>Jóvenes Españoles de
              Matemática Aplicada</em>, young Spanish researchers in applied mathematics) of the Spanish Society of
              Applied Mathematics (SEMA): monthly online sessions where early-career researchers present their work
              in applied mathematics and connect with other groups.
            </>
          )
        }
      </p>
    </div>
  </Card>
</HomeSection>
