---
import type { CollectionEntry } from 'astro:content';
import Entry from '@/components/Entry.astro';
import Tag from '@/components/ui/Tag.astro';
import { UI, l, formatRange, type Lang } from '@/i18n';

interface Props {
  talk: CollectionEntry<'talks'>;
  lang: Lang;
  /** `timeline`: node on the talks timeline of the home page; `entry`: CV row. */
  variant?: 'entry' | 'timeline';
}
const { talk, lang, variant = 'entry' } = Astro.props;
const t = talk.data;
const ui = UI[lang];
const when = formatRange(t.start, t.end, lang);
---

{
  variant === 'entry' ? (
    <Entry when={when}>
      <span class="font-semibold">{t.title}</span>
      {t.authors.length > 0 && (
        <span class="text-ink-soft block text-sm">
          {t.authors.map((a, i) => (
            <>
              {i > 0 && ', '}
              {a}
            </>
          ))}
        </span>
      )}
      <span class="block text-sm">
        <em>{t.eventUrl ? <a href={t.eventUrl}>{l(t.event, lang)}</a> : l(t.event, lang)}</em>. {l(t.city, lang)},{' '}
        {l(t.country, lang)}. <Tag>{t.scope === 'international' ? ui.international : ui.national}</Tag>
      </span>
      {(t.slides || t.video) && (
        <span class="mt-0.5 flex gap-3 text-sm">
          {t.slides && <a href={t.slides}>{ui.slides}</a>}
          {t.video && <a href={t.video}>{ui.video}</a>}
        </span>
      )}
    </Entry>
  ) : (
    <li class="relative grid grid-cols-1 gap-x-8 gap-y-2 pl-6 sm:grid-cols-(--cols-entry) sm:pl-0">
      <span class="text-ink-soft text-sm font-semibold tabular-nums sm:pt-5 sm:text-right">{when}</span>
      <span class="border-water bg-paper absolute top-1.5 left-0 size-3 rounded-full border-2 sm:top-6 sm:left-(--talk-node)" aria-hidden="true" />
      <div class="bg-surface border-line rounded-xl border p-4 sm:ml-4 sm:p-5">
        <p class="text-deep text-sm font-semibold">
          {t.eventUrl ? <a href={t.eventUrl} class="text-deep">{l(t.event, lang)}</a> : l(t.event, lang)}
        </p>
        <p class="font-display mt-1.5 text-lg leading-snug font-bold">{t.title}</p>
        {t.authors.length > 0 && (
          <p class="text-ink-soft mt-1 text-sm">
            {t.authors.map((a, i) => (
              <>
                {i > 0 && ', '}
                {a === t.presenter ? <span class="text-ink">{a}</span> : a}
              </>
            ))}
          </p>
        )}
        <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
          <span>
            {l(t.city, lang)}, {l(t.country, lang)}
          </span>
          <Tag tone={t.scope === 'international' ? 'accent' : 'plain'}>{t.scope === 'international' ? ui.international : ui.national}</Tag>
          {t.slides && <a href={t.slides}>{ui.slides}</a>}
          {t.video && <a href={t.video}>{ui.video}</a>}
        </p>
      </div>
    </li>
  )
}
