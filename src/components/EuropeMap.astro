---
// Approximate outline of Europe with a star on every city where I have given
// a talk. The outline is pre-generated by scripts/europe-map.py; markers use
// the same equirectangular projection.
import type { CollectionEntry } from 'astro:content';
import { EUROPE } from '@/data/europe-outline';
import { l, type Lang } from '@/i18n';

interface Props {
  talks: CollectionEntry<'talks'>[];
  lang: Lang;
}
const { talks, lang } = Astro.props;

const project = ([lat, lon]: readonly [number, number]) => ({
  x: (lon - EUROPE.lonMin) * EUROPE.cos * EUROPE.k,
  y: (EUROPE.latMax - lat) * EUROPE.k,
});

// One marker per city, however many talks were given there.
const cities = new Map<string, { name: string; x: number; y: number; count: number }>();
for (const talk of talks) {
  const name = l(talk.data.city, lang);
  const prev = cities.get(name);
  cities.set(name, { name, ...project(talk.data.coords), count: (prev?.count ?? 0) + 1 });
}
const markers = [...cities.values()].map((m, _, all) => {
  // Put the label on the left when another marker sits just to the right.
  const crowded = all.some((o) => o !== m && o.x > m.x && o.x - m.x < 110 && Math.abs(o.y - m.y) < 25);
  return { ...m, side: crowded ? 'left' : 'right' };
});
const home = { name: 'Málaga', ...project([36.72, -4.42]) };

const star = (cx: number, cy: number, r = 12) =>
  Array.from({ length: 10 }, (_, i) => {
    const radius = i % 2 === 0 ? r : r * 0.42;
    const angle = (Math.PI / 5) * i - Math.PI / 2;
    return `${(cx + radius * Math.cos(angle)).toFixed(1)},${(cy + radius * Math.sin(angle)).toFixed(1)}`;
  }).join(' ');

const caption =
  lang === 'es'
    ? 'Mapa de Europa con una estrella en cada ciudad donde he presentado una comunicación.'
    : 'Map of Europe with a star on every city where I have given a talk.';
---

<figure class="my-6">
  <svg
    viewBox={`0 0 ${EUROPE.width} ${EUROPE.height}`}
    role="img"
    aria-label={`${caption} ${markers.map((m) => m.name).join(', ')}.`}
    class="block h-auto w-full"
  >
    <path d={EUROPE.path} class="stroke-ink-soft fill-none" stroke-width="0.9" stroke-linejoin="round" />

    <g class="fill-ink-soft">
      <circle cx={home.x} cy={home.y} r="4.5" />
      <text x={home.x + 8} y={home.y + 18} font-size="16" class="font-serif italic">{home.name}</text>
    </g>

    {
      markers.map((m) => (
        <g>
          <polygon points={star(m.x, m.y)} class="fill-ink stroke-paper" stroke-width="1.5" />
          <text
            x={m.side === 'left' ? m.x - 16 : m.x + 16}
            y={m.y + 6}
            text-anchor={m.side === 'left' ? 'end' : 'start'}
            font-size="18"
            class="fill-ink stroke-paper font-serif"
            stroke-width="3"
            paint-order="stroke"
          >
            {m.name}
            {m.count > 1 && ` (${m.count})`}
          </text>
        </g>
      ))
    }
  </svg>
  <figcaption class="text-ink-soft mt-2 text-center text-[0.9rem]">{caption}</figcaption>
</figure>
