---
import type { CollectionEntry } from 'astro:content';
import Entry from '@/components/Entry.astro';
import { l, type Lang } from '@/i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
  compact?: boolean;
}
const { project, lang, compact = false } = Astro.props;
const p = project.data;
const when = `${p.start.getUTCFullYear()} – ${p.end.getUTCFullYear()}`;
const pi = lang === 'es' ? 'IP' : p.pis.length > 1 ? 'PIs' : 'PI';
---

<Entry when={when}>
  <span class="font-bold">
    {p.acronym && <>{p.url ? <a href={p.url}>{p.acronym}</a> : p.acronym}: </>}
    {l(p.title, lang)}
  </span>
  <span class="text-ink-soft block text-[0.95rem]">
    {l(p.funder, lang)}{p.reference && <> ({p.reference})</>}. {pi}: {p.pis.join(', ')}.
  </span>
  {!compact && p.summary && <span class="block text-[0.95rem]">{l(p.summary, lang)}</span>}
</Entry>
