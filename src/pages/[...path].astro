---
// One dynamic route generates every page in both languages from ROUTES
// (src/i18n.ts): the home page (all sections) and the CV.
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Home from '@/views/Home.astro';
import Cv from '@/views/Cv.astro';
import { SITE } from '@/site.config';
import { LANGS, PAGES, ROUTES, NAV_LABELS, DESCRIPTIONS, type Lang, type PageKey } from '@/i18n';

export const getStaticPaths = (() =>
  PAGES.flatMap((page) =>
    LANGS.map((lang) => ({
      params: { path: ROUTES[page][lang].replace(/^\/|\/$/g, '') || undefined },
      props: { page, lang },
    })),
  )) satisfies GetStaticPaths;

interface Props {
  page: PageKey;
  lang: Lang;
}
const { page, lang } = Astro.props;
const title = page === 'home' ? SITE.name : NAV_LABELS[page][lang];
---

<BaseLayout title={title} description={DESCRIPTIONS[page][lang]} lang={lang} page={page}>
  {
    page === 'home' ? (
      <Home lang={lang} />
    ) : (
      <Container width="narrow" class="py-14 sm:py-20">
        <Cv lang={lang} />
      </Container>
    )
  }
</BaseLayout>
