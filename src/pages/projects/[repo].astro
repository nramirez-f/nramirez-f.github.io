---
import Layout from "@layouts/main.astro";
import projects from "@collections/projects.json";
import ButtonIcon from "@components/ButtonIcon.astro";
import GithubIcon from "@icons/GithubIcon.astro";

import { marked } from "marked";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { repo: project.repo },
    props: { project },
  }));
}

const { repo } = Astro.params;
const { project } = Astro.props;

const username = "nramirez-f";
const url = `https://raw.githubusercontent.com/${username}/${repo}/main/`;
const repo_url = `https://github.com/${username}/${repo}`;
const readme_url = url + "README.md";

// Configure marked with custom renderer
const renderer = new marked.Renderer();

// Override image renderer to make URLs absolute
renderer.image = function({ href, title, text }) {
  let absoluteHref = href;
  
  // Check if the URL is relative (doesn't start with http/https)
  if (href && typeof href === 'string' && !href.startsWith('http://') && !href.startsWith('https://')) {
    // Remove leading ./ if present
    const cleanHref = href.startsWith('./') ? href.slice(2) : href;
    absoluteHref = `${url}${cleanHref}`;
  }
  
  const titleAttr = title ? ` title="${title}"` : '';
  return `<img src="${absoluteHref}" alt="${text}"${titleAttr}>`;
};

// Override link renderer to make URLs absolute
renderer.link = function({ href, title, text }) {
  let absoluteHref = href;
  
  // Check if the URL is relative (doesn't start with http/https or #)
  if (href && typeof href === 'string' && !href.startsWith('http://') && !href.startsWith('https://') && !href.startsWith('#')) {
    // Remove leading ./ if present
    const cleanHref = href.startsWith('./') ? href.slice(2) : href;
    absoluteHref = `${repo_url}/blob/main/${cleanHref}`;
  }
  
  const titleAttr = title ? ` title="${title}"` : '';
  return `<a href="${absoluteHref}"${titleAttr}>${text}</a>`;
};

// Set the custom renderer
marked.setOptions({
  renderer: renderer
});

const res = await fetch(readme_url);
if (!res.ok) {
  throw new Error(`No se pudo cargar el README de ${repo}`);
}
const readme = await res.text();
let html: string = marked(readme) as string;

// Post-process HTML to fix relative image URLs in direct HTML img tags
html = html.replace(/<img([^>]+)src=["']([^"']+)["']([^>]*)>/g, (match: string, beforeSrc: string, src: string, afterSrc: string) => {
  let absoluteSrc = src;
  
  // Check if the URL is relative (doesn't start with http/https)
  if (src && typeof src === 'string' && !src.startsWith('http://') && !src.startsWith('https://')) {
    // Remove leading ./ if present
    const cleanSrc = src.startsWith('./') ? src.slice(2) : src;
    absoluteSrc = `${url}${cleanSrc}`;
  }
  
  return `<img${beforeSrc}src="${absoluteSrc}"${afterSrc}>`;
});

// Post-process HTML to fix relative link URLs in direct HTML a tags
html = html.replace(/<a([^>]+)href=["']([^"']+)["']([^>]*)>/g, (match: string, beforeHref: string, href: string, afterHref: string) => {
  let absoluteHref = href;
  
  // Check if the URL is relative (doesn't start with http/https or #)
  if (href && typeof href === 'string' && !href.startsWith('http://') && !href.startsWith('https://') && !href.startsWith('#')) {
    // Remove leading ./ if present
    const cleanHref = href.startsWith('./') ? href.slice(2) : href;
    absoluteHref = `${repo_url}/blob/main/${cleanHref}`;
  }
  
  return `<a${beforeHref}href="${absoluteHref}"${afterHref}>`;
});

// Post-process HTML to add IDs to headings for anchor links to work
html = html.replace(/<h([1-6])([^>]*)>([^<]+)<\/h([1-6])>/g, (match: string, level: string, attrs: string, text: string, endLevel: string) => {
  // Generate ID from heading text (similar to GitHub's approach)
  const id = text
    .toLowerCase()
    .trim()
    .replace(/[^\w\s-]/g, '') // Remove special characters except hyphens
    .replace(/\s+/g, '-') // Replace spaces with hyphens
    .replace(/-+/g, '-') // Replace multiple hyphens with single hyphen
    .replace(/^-|-$/g, ''); // Remove leading/trailing hyphens
  
  // Check if ID attribute already exists
  const hasId = attrs.includes('id=');
  const idAttr = hasId ? '' : ` id="${id}"`;
  
  return `<h${level}${attrs}${idAttr}>${text}</h${endLevel}>`;
});

// Post-process HTML to convert markdown image syntax within links to proper img tags
html = html.replace(/<a([^>]*)>!\[([^\]]*)\]\(([^)]+)\)<\/a>/g, (match: string, linkAttrs: string, altText: string, imgSrc: string) => {
  let absoluteImgSrc = imgSrc;
  
  // Check if the image URL is relative (doesn't start with http/https)
  if (imgSrc && typeof imgSrc === 'string' && !imgSrc.startsWith('http://') && !imgSrc.startsWith('https://')) {
    // Remove leading ./ if present
    const cleanSrc = imgSrc.startsWith('./') ? imgSrc.slice(2) : imgSrc;
    absoluteImgSrc = `${url}${cleanSrc}`;
  }
  
  return `<a${linkAttrs}><img src="${absoluteImgSrc}" alt="${altText}"></a>`;
});

console.log(html);
---

<Layout title={project.name}>
  <section class="max-w-3xl mx-auto p-8 prose dark:prose-invert">
    <div class="flex justify-end">
      <ButtonIcon text="Go to Repository" link={repo_url}>
        <GithubIcon class="w-6 h-6" />
      </ButtonIcon>
    </div>

    <div class="markdown mt-20" set:html={html} />
  </section>
</Layout>

<style is:global>
  .prose img {
    border-radius: 0 !important;
  }
</style>