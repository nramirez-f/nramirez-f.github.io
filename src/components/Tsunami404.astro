---
// The 404 illustration: a breaking wave rolls in over a mathematician busy
// checking the CFL condition on his board. Inline SVG animated with CSS (an
// in-house "gif": theme colours, a few KB, no licensing); under
// prefers-reduced-motion it is a still frame with the wave about to break.
interface Props {
  label: string;
}
const { label } = Astro.props;

// Sand line, gently uneven.
const W = 640;
const sand = Array.from({ length: 65 }, (_, i) => {
  const x = (i / 64) * W;
  const y = 300 + 5 * Math.sin((2 * Math.PI * 1.5 * x) / W + 0.8) + 2.5 * Math.sin((2 * Math.PI * 5 * x) / W);
  return `${x.toFixed(1)},${y.toFixed(1)}`;
});
const sandLine = `M${sand.join(' L')}`;

// Breaking wave: body from the left, crest curling over at x ≈ 400.
// The body extends far to the left so its end never shows while it rolls in.
const wave =
  'M-640,320 L-640,215 C-300,210 -120,200 -60,190 C40,175 150,140 235,95 C300,58 370,48 405,80 C428,102 418,134 390,137 C368,139 358,120 374,110 C344,118 322,160 332,210 C340,250 365,288 410,320 Z';
const crest =
  'M-640,215 C-300,210 -120,200 -60,190 C40,175 150,140 235,95 C300,58 370,48 405,80 C428,102 418,134 390,137 C368,139 358,120 374,110';
const foam = [
  [398, 70, 5],
  [414, 88, 4],
  [384, 60, 3.5],
  [420, 112, 3],
  [366, 58, 3],
] as const;
---

<svg viewBox={`0 0 ${W} 360`} role="img" aria-label={label} class="block h-auto w-full">
  {/* Board on its easel. */}
  <g>
    <line x1="520" y1="238" x2="508" y2="302" class="stroke-ink-soft" stroke-width="3" stroke-linecap="round" />
    <line x1="600" y1="238" x2="612" y2="302" class="stroke-ink-soft" stroke-width="3" stroke-linecap="round" />
    <rect x="490" y="150" width="140" height="92" rx="6" class="fill-deep stroke-ink-soft" stroke-width="2" />
    <text x="560" y="194" text-anchor="middle" class="fill-paper font-serif italic" font-size="24">CFL ≤ 1 ?</text>
    <text x="560" y="222" text-anchor="middle" class="fill-paper font-serif italic" font-size="14" opacity="0.75">
      Δt ≤ Δx / |λ|
    </text>
  </g>

  {/* The mathematician: glasses, chalk in hand, jumps when the wave arrives. */}
  <g class="motion-safe:animate-panic transform-fill origin-bottom stroke-ink" fill="none" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
    <line x1="448" y1="300" x2="458" y2="258" />
    <line x1="468" y1="300" x2="458" y2="258" />
    <line x1="458" y1="258" x2="458" y2="212" />
    <line x1="458" y1="226" x2="494" y2="206" />
    <line x1="458" y1="226" x2="436" y2="246" />
    <circle cx="458" cy="194" r="15" class="fill-surface" />
    <circle cx="452" cy="193" r="4" stroke-width="2" />
    <circle cx="465" cy="193" r="4" stroke-width="2" />
    <line x1="456" y1="193" x2="461" y2="193" stroke-width="2" />
    <circle cx="496" cy="205" r="2" class="fill-paper stroke-none" />
  </g>

  {/* The wave. */}
  <g class="motion-safe:animate-tsunami">
    <path d={wave} class="fill-water" fill-opacity="0.5" />
    <path d={wave} class="fill-water" fill-opacity="0.35" transform="translate(-40 24)" />
    <path d={crest} class="stroke-water" fill="none" stroke-width="3.5" stroke-linecap="round" />
    {foam.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} class="fill-surface stroke-water" stroke-width="1.5" />)}
  </g>

  {/* Sand, over the foot of the wave. */}
  <path d={`${sandLine} L${W},360 L0,360 Z`} class="fill-sand" />
  <path d={sandLine} class="stroke-bed" fill="none" stroke-width="2.5" />
</svg>
